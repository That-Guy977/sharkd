  m_TableData:
  - m_Id: 15509746801958912
    m_Localized: Press {input.move:{Left}/{Right}} to  move.
    m_Metadata:
      m_Items:
      - rid: 5295356236482740224
  - m_Id: 15510365222723584
    m_Localized: Press {input.jump} to jump.
    m_Metadata:
      m_Items:
      - rid: 5295356236482740224
  - m_Id: 15510511666847744
    m_Localized: Hold {input.move} and press {input.dash} to dash.
    m_Metadata:
      m_Items:
      - rid: 5295356236482740224
  - m_Id: 15510603534688256
    m_Localized: Hold {input.attack} to attack.
    m_Metadata:
      m_Items:
      - rid: 5295356236482740224
  - m_Id: 15529109621825536
    m_Localized: Watch your <color=#00A8FF>Mana</color>!
    m_Metadata:
      m_Items: []
  - m_Id: 15510788230864896
    m_Localized: You can now transform into Gawr!
    m_Metadata:
      m_Items: []
  - m_Id: 15510868870553600
    m_Localized: Press {input.turn} to transform.
    m_Metadata:
      m_Items:
      - rid: 5295356236482740224
  - m_Id: 15511002563993600
    m_Localized: As Gawr, press {input.attack} to attack. Slashing does not consume
      <color=#00A8FF>Mana</color>.
    m_Metadata:
      m_Items: []
